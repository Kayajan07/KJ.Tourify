@using KJ.Tourify.WebUI.Models.Entities
@model ServicePage
<partial name="_PageHeader" model="new PageHeaderViewModel(Model.ServiceHeader)" />
    
    <div class="container-fluid bg-soft service py-5">
        <div class="container py-5">
            <div class="mx-auto text-center mb-5 section-intro">
                <p class="section-title px-3">@Model.ServiceUpperTitle</p>
                <h2 class="mb-0">@Model.ServiceTitle</h2>
            </div>

            <div class="row g-4 justify-content-center">
                <div class="col-sm-6 col-lg-3">
                    <div class="service-content-inner h-100 text-center border-brand rounded p-4">
                        <div class="service-icon mb-3">
                            <i class="@Model.Service1Icon" aria-hidden="true"></i>
                        </div>
                        <div class="service-content">
                            <h3 class="service-title mb-3">@Model.Service1Title</h3>
                            <p class="mb-0">
                                @Model.Service1Description
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <div class="service-content-inner h-100 text-center border-brand rounded p-4">
                        <div class="service-icon mb-3">
                            <i class="@Model.Service2Icon" aria-hidden="true"></i>
                        </div>
                        <div class="service-content">
                            <h3 class="service-title mb-3">@Model.Service2Title</h3>
                            <p class="mb-0">
                                @Model.Service2Description
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <div class="service-content-inner h-100 text-center border-brand rounded p-4">
                        <div class="service-icon mb-3">
                            <i class="@Model.Service3Icon" aria-hidden="true"></i>
                        </div>
                        <div class="service-content">
                            <h3 class="service-title mb-3">@Model.Service3Title</h3>
                            <p class="mb-0">
                                @Model.Service3Description
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <div class="service-content-inner h-100 text-center border-brand rounded p-4">
                        <div class="service-icon mb-3">
                            <i class="@Model.Service4Icon" aria-hidden="true"></i>
                        </div>
                        <div class="service-content">
                            <h3 class="service-title mb-3">@Model.Service4Title</h3>
                            <p class="mb-0">
                                @Model.Service4Description
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-12 text-center mt-2">
                    <a class="btn btn-primary rounded-pill py-3 px-5" asp-controller="Home" asp-action="Contact">@Model.ServicePageButtonText</a>
                </div>
            </div>
        </div>
    </div>
    