@using KJ.Tourify.WebUI.Models.Entities

@{ var pageHeader = new PageHeaderViewModel("404 Page"); }
<partial name="_PageHeader" model="pageHeader" />
    <div class="container-fluid notfound py-5">
        <div class="container py-5 text-center">
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <i class="bi bi-exclamation-triangle display-1 text-brand" aria-hidden="true"></i>
                    <p class="display-1 notfound-code">404</p>
                    <h2 class="mb-4">Page Not Found</h2>
                    <p class="mb-4">We’re sorry, the page you have looked for does not exist in our website! Maybe go to our home page or try to use a search?</p>
                    <a class="btn btn-primary rounded-pill py-3 px-5" asp-controller="Home" asp-action="Index">Go Back To Home</a>
                </div>
            </div>
        </div>
    </div>
    
