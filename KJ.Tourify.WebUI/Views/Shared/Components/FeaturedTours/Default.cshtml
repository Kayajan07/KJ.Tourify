@model List<TourItem>
@if (Model.Count > 0)
{
    <section class="container-fluid packages featured-tours py-5" aria-labelledby="featured-tours-title">
        <div class="container py-5">
            <div class="section-heading">
                <div>
                    <p class="section-title">Featured Tours</p>
                    <h2 id="featured-tours-title" class="section-heading-title">Popular routes our travelers love</h2>
                </div>
                <a asp-controller="Home" asp-action="Tours" class="btn btn-outline-brand rounded-pill">
                    View All Tours <i class="fa fa-arrow-right ms-2" aria-hidden="true"></i>
                </a>
            </div>
            <div class="row g-4 tour-grid">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <partial name="_TourCard" model="item" />
                    </div>
                }
            </div>
        </div>
    </section>
}
