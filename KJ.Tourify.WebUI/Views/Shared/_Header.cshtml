        <div class="container-fluid position-relative p-0">
            <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand p-0" aria-label="Tourify home">
                    <span class="navbar-brand-text"><i class="fa fa-map-marker-alt me-3" aria-hidden="true"></i>Tourify</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="fa fa-bars" aria-hidden="true"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCollapse">
                @{
                    var action = ViewContext.RouteData.Values["action"]?.ToString();
                }

                <div class="navbar-nav ms-auto py-0">
                    <a asp-controller="Home" asp-action="Index"
                       class="nav-item nav-link @(action == "Index" ? "active" : "")" aria-current="@(action == "Index" ? "page" : null)">Home</a>

                    <a asp-controller="Home" asp-action="About"
                       class="nav-item nav-link @(action == "About" ? "active" : "")" aria-current="@(action == "About" ? "page" : null)">About</a>

                    <a asp-controller="Home" asp-action="Guides"
                       class="nav-item nav-link @(action == "Guides" ? "active" : "")" aria-current="@(action == "Guides" ? "page" : null)">Guides</a>

                    <a asp-controller="Home" asp-action="Services"
                       class="nav-item nav-link @(action == "Services" ? "active" : "")" aria-current="@(action == "Services" ? "page" : null)">Services</a>

                    <a asp-controller="Home" asp-action="Tours"
                       class="nav-item nav-link @(action == "Tours" ? "active" : "")" aria-current="@(action == "Tours" ? "page" : null)">Tours</a>

                    <a asp-controller="Home" asp-action="Gallery"
                       class="nav-item nav-link @(action == "Gallery" ? "active" : "")" aria-current="@(action == "Gallery" ? "page" : null)">Gallery</a>
                

                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Pages</a>
                            <div class="dropdown-menu m-0">
                            
                                <a asp-controller="Home" asp-action="Tour" class="dropdown-item">Explore Tour</a>
                                <a asp-controller="Home" asp-action="Booking" class="dropdown-item">Travel Booking</a>
                                <a asp-controller="Home" asp-action="Gallery" class="dropdown-item">Our Gallery</a>
                                <a asp-controller="Home" asp-action="Guides" class="dropdown-item">Travel Guides</a>
                                <a asp-controller="Home" asp-action="NotFoundPage" class="dropdown-item">404 Page</a>
                            </div>
                        </div>
                    <a asp-controller="Home" asp-action="Contact"
                       class="nav-item nav-link @(action == "Contact" ? "active" : "")" aria-current="@(action == "Contact" ? "page" : null)">Contact</a>
                    </div>
                <a asp-controller="Home" asp-action="Booking" class="btn btn-cta rounded-pill py-2 px-4 ms-lg-4">Book Now</a>
                </div>
            </nav>
        </div>
