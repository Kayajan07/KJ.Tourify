@model TourItem

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Yeni Öğe Ekle</h5>
        <a class="btn btn-primary float-end" asp-action="Index">Geri</a>
    </div>
    <div class="card-body">

        <div class="mb-6">
            <label class="form-label" asp-for="HowMuchMoney"></label>
            <input class="form-control" asp-for="HowMuchMoney" type="text" disabled readonly />
        </div>

        <div class="mb-6">
            <label class="form-label" asp-for="Title"></label>
            <input class="form-control" asp-for="Title" type="text" disabled readonly />
        </div>

        <div class="mb-6">
            <label class="form-label" asp-for="Description"></label>
            <textarea class="form-control" asp-for="Description" disabled readonly></textarea>
        </div>

        <div class="mb-6">
            <label class="form-label" asp-for="TourImageUrl"></label>
            <input type="file" class="form-control" name="TourImage">
            <span asp-validation-for="TourImageUrl" style="color: red;"></span>
        </div>

        <div class="mb-6">
            <label class="form-label" asp-for="TourLocation"></label>
            <textarea class="form-control" asp-for="TourLocation" disabled readonly></textarea>
        </div>

        <div class="mb-6">
            <label class="form-label" asp-for="TourCityId"></label>
            <input class="form-control" type="text" value="@Model.City?.Name" disabled readonly />
        </div>

        

    </div>
</div>
