@model GalleryItem

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Galeri Ogesi Detay</h5>
        <a class="btn btn-primary float-end" asp-action="Index">Geri</a>
    </div>
    <div class="card-body">
        
        <div class="mb-6">
            <label class="form-label" asp-for="Title"></label>
            <input class="form-control" asp-for="Title" type="text" disabled readonly />
        </div>
        <div class="mb-6">
            <label class="form-label" asp-for="GalleryImageUrl"></label>
            <input class="form-control" asp-for="GalleryImageUrl" type="text" disabled readonly />
        </div>

        <div class="mb-6">
            <label class="form-label" asp-for="GalleryCategoryId"></label>
            <input class="form-control" type="text" value="@Model.GalleryCategory?.Name" disabled readonly />
        </div>

        
    </div>
</div>
