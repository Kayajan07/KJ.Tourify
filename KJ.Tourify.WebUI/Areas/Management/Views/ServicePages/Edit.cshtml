@using KJ.Tourify.WebUI.Models.Entities
@model ServicePage

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Service Page Düzenle</h5>
        <a class="btn btn-primary float-end" asp-action="Index">Geri</a>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" style="color: red;"></div>

            @Html.HiddenFor(x => x.Id)

            <div class="mb-6">
                <label class="form-label" asp-for="ServiceHeader"></label>
                <input type="text" class="form-control" asp-for="ServiceHeader">
                <span asp-validation-for="ServiceHeader" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="ServiceUpperTitle"></label>
                <input type="text" class="form-control" asp-for="ServiceUpperTitle">
                <span asp-validation-for="ServiceUpperTitle" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="ServiceTitle"></label>
                <input type="text" class="form-control" asp-for="ServiceTitle">
                <span asp-validation-for="ServiceTitle" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Service1Icon"></label>
                <input type="text" class="form-control" asp-for="Service1Icon">
                <span asp-validation-for="Service1Icon" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Service1Title"></label>
                <input type="text" class="form-control" asp-for="Service1Title">
                <span asp-validation-for="Service1Title" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Service1Description"></label>
                <textarea class="form-control" asp-for="Service1Description"></textarea>
                <span asp-validation-for="Service1Description" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Service2Icon"></label>
                <input type="text" class="form-control" asp-for="Service2Icon">
                <span asp-validation-for="Service2Icon" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Service2Title"></label>
                <input type="text" class="form-control" asp-for="Service2Title">
                <span asp-validation-for="Service2Title" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Service2Description"></label>
                <textarea class="form-control" asp-for="Service2Description"></textarea>
                <span asp-validation-for="Service2Description" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Service3Icon"></label>
                <input type="text" class="form-control" asp-for="Service3Icon">
                <span asp-validation-for="Service3Icon" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Service3Title"></label>
                <input type="text" class="form-control" asp-for="Service3Title">
                <span asp-validation-for="Service3Title" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Service3Description"></label>
                <textarea class="form-control" asp-for="Service3Description"></textarea>
                <span asp-validation-for="Service3Description" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Service4Icon"></label>
                <input type="text" class="form-control" asp-for="Service4Icon">
                <span asp-validation-for="Service4Icon" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Service4Title"></label>
                <input type="text" class="form-control" asp-for="Service4Title">
                <span asp-validation-for="Service4Title" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Service4Description"></label>
                <textarea class="form-control" asp-for="Service4Description"></textarea>
                <span asp-validation-for="Service4Description" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="ServicePageButtonText"></label>
                <input type="text" class="form-control" asp-for="ServicePageButtonText">
                <span asp-validation-for="ServicePageButtonText" style="color: red;"></span>
            </div>

            <button type="submit" class="btn btn-primary">Send</button>
        </form>
    </div>
</div>
