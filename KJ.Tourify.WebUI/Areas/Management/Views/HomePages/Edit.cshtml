@using KJ.Tourify.WebUI.Models.Entities
@model HomePage

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Anasayfa Düzenle</h5>
        <a class="btn btn-primary float-end" asp-action="Index">Geri</a>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" style="color: red;"></div>

            @Html.HiddenFor(x => x.Id)
            @Html.HiddenFor(x => x.ImageUrl1)
            @Html.HiddenFor(x => x.ImageUrl2)
            @Html.HiddenFor(x => x.ImageUrl3)
            @Html.HiddenFor(x => x.HomeAboutImageUrl)

            <div class="mb-6">
                <label class="form-label" asp-for="UpperTitle"></label>
                <input type="text" class="form-control" asp-for="UpperTitle">
                <span asp-validation-for="UpperTitle" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Title1"></label>
                <textarea class="form-control" asp-for="Title1"></textarea>
                <span asp-validation-for="Title1" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <img src="@Model.ImageUrl1" width="75" />
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="ImageUrl1"></label>
                <input type="file" class="form-control" name="ImageUrl1">
                <span asp-validation-for="ImageUrl1" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Title2"></label>
                <input type="text" class="form-control" asp-for="Title2">
                <span asp-validation-for="Title2" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <img src="@Model.ImageUrl2" width="75" />
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="ImageUrl2"></label>
                <input type="file" class="form-control" name="ImageUrl2">
                <span asp-validation-for="ImageUrl2" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Title3"></label>
                <input type="text" class="form-control" asp-for="Title3">
                <span asp-validation-for="Title3" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <img src="@Model.ImageUrl3" width="75" />
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="ImageUrl3"></label>
                <input type="file" class="form-control" name="ImageUrl3">
                <span asp-validation-for="ImageUrl3" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="Description"></label>
                <input type="text" class="form-control" asp-for="Description">
                <span asp-validation-for="Description" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="HomeAboutUpperTitle"></label>
                <textarea type="text" class="form-control" asp-for="HomeAboutUpperTitle"></textarea>
                <span asp-validation-for="HomeAboutUpperTitle" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <img src="@Model.HomeAboutImageUrl" width="75" />
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="HomeAboutImageUrl"></label>
                <input type="file" class="form-control" name="HomeAboutImageUrl">
                <span asp-validation-for="HomeAboutImageUrl" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="HomeAboutTitle"></label>
                <input type="text" class="form-control" asp-for="HomeAboutTitle">
                <span asp-validation-for="HomeAboutTitle" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="HomeAboutDescription"></label>
                <input type="text" class="form-control" asp-for="HomeAboutDescription">
                <span asp-validation-for="HomeAboutDescription" style="color: red;"></span>
            </div>


            <div class="mb-6">
                <label class="form-label" asp-for="HomeAboutButtonText"></label>
                <input type="text" class="form-control" asp-for="HomeAboutButtonText">
                <span asp-validation-for="HomeAboutButtonText" style="color: red;"></span>
            </div>

            

            

            

            

            <div class="mb-6">
                <label class="form-label" asp-for="HomeAboutServicesTitle"></label>
                <textarea type="text" class="form-control" asp-for="HomeAboutServicesTitle"></textarea>
                <span asp-validation-for="HomeAboutServicesTitle" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="HomeAboutServicesButtonText"></label>
                <textarea type="text" class="form-control" asp-for="HomeAboutServicesButtonText"></textarea>
                <span asp-validation-for="HomeAboutServicesButtonText" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="HomeAboutService1"></label>
                <textarea type="text" class="form-control" asp-for="HomeAboutService1"></textarea>
                <span asp-validation-for="HomeAboutService1" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="HomeAboutService2"></label>
                <textarea type="text" class="form-control" asp-for="HomeAboutService2"></textarea>
                <span asp-validation-for="HomeAboutService2" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="HomeAboutService3"></label>
                <textarea type="text" class="form-control" asp-for="HomeAboutService3"></textarea>
                <span asp-validation-for="HomeAboutService3" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="HomeAboutService4"></label>
                <textarea type="text" class="form-control" asp-for="HomeAboutService4"></textarea>
                <span asp-validation-for="HomeAboutService4" style="color: red;"></span>
            </div>
            <div class="mb-6">
                <label class="form-label" asp-for="HomePageDestinationTitle"></label>
                <input type="text" class="form-control" asp-for="HomePageDestinationTitle">
                <span asp-validation-for="HomePageDestinationTitle" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="HomeDestinationDescription"></label>
                <input type="text" class="form-control" asp-for="HomeDestinationDescription">
                <span asp-validation-for="HomeDestinationDescription" style="color: red;"></span>
            </div>

            <div class="mb-6">
                <label class="form-label" asp-for="HomeDestinationButtonText"></label>
                <input type="text" class="form-control" asp-for="HomeDestinationButtonText">
                <span asp-validation-for="HomeDestinationButtonText" style="color: red;"></span>
            </div>

            <button type="submit" class="btn btn-primary">Send</button>
        </form>
    </div>
</div>
