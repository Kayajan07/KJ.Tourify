@using KJ.Tourify.WebUI.Models.Entities
@model TourPage

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Hakkımızda Düzenle</h5>
        <a class="btn btn-primary float-end" asp-action="Index">Geri</a>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">

            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" style="color: red;"></div>

            @Html.HiddenFor(x => x.Id)
            

            <div class="mb-6">
                <label class="form-label" asp-for="TourHeader"></label>
                <input type="text" class="form-control" asp-for="TourHeader">
                    <span asp-validation-for="TourHeader" style="color: red;"></span>
                </div>

                <div class="mb-6">
                    <label class="form-label" asp-for="TourUpperTitle"></label>
                    <input type="text" class="form-control" asp-for="TourUpperTitle">
                        <span asp-validation-for="TourUpperTitle" style="color: red;"></span>
                    </div>

                    <div class="mb-6">
                        <label class="form-label" asp-for="TourTitle"></label>
                        <input type="text" class="form-control" asp-for="TourTitle">
                            <span asp-validation-for="TourTitle" style="color: red;"></span>
                        </div>

                        
                            

                        <button type="submit" class="btn btn-primary">Send</button>
                    </form>
                </div>
            </div>